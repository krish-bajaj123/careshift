  "sources": [
    {
      "used_for": "bath twice a week minimum (why a refused bath is re-planned, not dropped)",
      "source": "Ontario O. Reg. 246/22 (Fixing Long-Term Care Act, 2021), s. 37 Bathing",
      "url": "https://www.ontario.ca/laws/regulation/220246"
    },
    {
      "used_for": "2-hour repositioning for high-risk residents",
      "source": "Health Quality Ontario, Pressure Injuries quality standard, Statement 6",
      "url": "https://hqontario.ca/Evidence-to-Improve-Care/Quality-Standards/View-All-Quality-Standards/Pressure-Injuries/Quality-Statement-6-Repositioning"
    },
    {
      "used_for": "~4 h direct care per resident per day (staffing ratio of 1 PSW : 4 residents on our demo wing is illustrative only)",
      "source": "Ontario Ministry of Long-Term Care news release, Oct 2025",
      "url": "https://todaysnorthumberland.ca/2025/10/16/ontario-investing-nearly-2-billion-to-protect-and-expand-long-term-care/"
    },
    {
      "used_for": "most residents have dementia",
      "source": "OLTCA 2015 (already cited in P3)",
      "url": "https://directory.oltca.com/oltca/OLTCA/Public/MediaEvents/News_Releases/Expansion_of_Mental_Health_Supports.aspx"
    },
    {
      "used_for": "refusals get noted and retried later; families want weekly mood/meds/food/sleep/activities summary",
      "source": "Our co-creation feedback (Tara, Alan, Christie & Alex), D4",
      "url": null
    },
    {
      "used_for": "DEMO VALUES, to confirm with the home: per-task assignee, second_assignee (t4), duration_min, latest (essential = due + 30 min, flexible = shift end), allowed_roles, kind; tasks t8-t10 (RPN medication passes and wound check); 15-min minimum gap before re-approaching a refused task; re-approach by a different nurse after a medication refusal; 2nd medication refusal escalates to the charge nurse and is logged as missed",
      "source": "CareShift v0.2 demo assumptions, not yet confirmed with Maplewood",
      "url": null
    }
  ],
